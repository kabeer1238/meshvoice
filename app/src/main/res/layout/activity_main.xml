<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#101418">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/riderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Your name"
        android:textColorHint="#8A94A0"
        android:textColor="#FFFFFF"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/rideCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ride code"
        android:textColorHint="#8A94A0"
        android:textColor="#FFFFFF"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/startStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="START RIDE"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/peerCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not riding"
        android:textColor="#B0BAC5"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/audioStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#B0BAC5"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#5C6773"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
