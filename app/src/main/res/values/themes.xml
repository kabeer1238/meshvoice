<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Launch theme. Uses the AndroidX SplashScreen API so the RideMesh emblem
      is shown by the system from the moment the icon is tapped, then hands
      off to Theme.RideMesh once MainActivity is ready. This removes the
      black "dead" window Beta 1 showed during cold start.
    -->
    <style name="Theme.RideMesh.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.RideMesh</item>
    </style>

    <style name="Theme.RideMesh" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:fontFamily">sans</item>
    </style>

</resources>
